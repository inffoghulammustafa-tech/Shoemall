<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KICKS-NEON // Next-Gen Footwear & Sneakers</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        neonCyan: '#00f3ff',
                        neonCrimson: '#ff0055',
                        neonPurple: '#9d00ff',
                        darkBg: '#090a0f',
                        darkCard: '#11131f',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'glow-cyan': '0 0 25px rgba(0, 243, 255, 0.6), inset 0 0 10px rgba(0, 243, 255, 0.3)',
                        'glow-crimson': '0 0 25px rgba(255, 0, 85, 0.6), inset 0 0 10px rgba(255, 0, 85, 0.3)',
                        'glow-purple': '0 0 25px rgba(157, 0, 255, 0.6), inset 0 0 10px rgba(157, 0, 255, 0.3)',
                        'glow-box': '0 10px 30px -10px rgba(0, 243, 255, 0.3)',
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 2s infinite alternate',
                        'float': 'float 4s ease-in-out infinite',
                        'spin-slow': 'spin 15s linear infinite',
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%': { boxShadow: '0 0 15px rgba(0, 243, 255, 0.4)' },
                            '100%': { boxShadow: '0 0 35px rgba(255, 0, 85, 0.8)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-12px)' },
                        }
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #090a0f;
            color: #f3f4f6;
            overflow-x: hidden;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090a0f;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f293d;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00f3ff;
        }

        /* Neon Glassmorphism Effects */
        .glass-card {
            background: rgba(17, 19, 31, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-nav {
            background: rgba(9, 10, 15, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0, 243, 255, 0.2);
        }

        /* Neon Text Glow */
        .text-glow-cyan {
            text-shadow: 0 0 10px rgba(0, 243, 255, 0.8), 0 0 20px rgba(0, 243, 255, 0.4);
        }
        .text-glow-crimson {
            text-shadow: 0 0 10px rgba(255, 0, 85, 0.8), 0 0 20px rgba(255, 0, 85, 0.4);
        }

        /* Canvas background overlay */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }

        /* Card Hover Glow Transition */
        .product-card {
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .product-card:hover {
            transform: translateY(-8px) scale(1.02);
            border-color: rgba(0, 243, 255, 0.6);
            box-shadow: 0 15px 35px -10px rgba(0, 243, 255, 0.3), 0 0 20px rgba(0, 243, 255, 0.2);
        }

        .fancy-card:hover {
            border-color: rgba(255, 0, 85, 0.6);
            box-shadow: 0 15px 35px -10px rgba(255, 0, 85, 0.3), 0 0 20px rgba(255, 0, 85, 0.2);
        }

        /* Glowing Video Overlay */
        .video-overlay {
            background: radial-gradient(circle, rgba(9,10,15,0.4) 0%, rgba(9,10,15,0.95) 90%);
        }

        /* Star Rating Interactive */
        .star-rating .fa-star {
            color: #4b5563;
            transition: color 0.2s;
        }
        .star-rating .fa-star.active {
            color: #facc15;
            text-shadow: 0 0 8px rgba(250, 204, 21, 0.6);
        }
    </style>
</head>
<body class="relative">

