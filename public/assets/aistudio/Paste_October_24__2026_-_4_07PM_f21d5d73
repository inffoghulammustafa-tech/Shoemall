        function toggleCart() {
            cartDrawer.classList.toggle('translate-x-full');
        }

        cartBtn.addEventListener('click', toggleCart);
        closeCartBtn.addEventListener('click', toggleCart);

        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            const existingItem = cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.qty += 1;
            } else {
                cart.push({ ...product, qty: 1 });
            }

            updateCartUI();
            cartDrawer.classList.remove('translate-x-full');
        }

        function removeFromCart(productId) {
            cart = cart.filter(item => item.id !== productId);
            updateCartUI();
        }

        function updateQty(productId, delta) {
            const item = cart.find(i => i.id === productId);
            if (item) {
                item.qty += delta;
                if (item.qty <= 0) removeFromCart(productId);
                else updateCartUI();
            }
        }

        function updateCartUI() {
            const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
            cartBadge.textContent = totalItems;
            if (totalItems > 0) cartBadge.classList.remove('scale-0');
            else cartBadge.classList.add('scale-0');

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div class="text-center text-gray-500 py-12">
                        <i class="fa-solid fa-cart-flatbed text-4xl mb-3 text-gray-700"></i>
                        <p>Your shopping cart is currently empty.</p>
                    </div>
                `;
                cartTotal.textContent = formatPrice(0);
                return;
            }

            let html = '';
            let totalUSD = 0;

            cart.forEach(item => {
                const itemTotalUSD = item.priceUSD * item.qty;
                totalUSD += itemTotalUSD;

                html += `
                    <div class="flex items-center space-x-3 bg-darkCard/80 p-3 rounded-xl border border-gray-800">
                        <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-lg border border-gray-700">
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-white truncate">${item.name}</h4>
                            <p class="text-xs text-neonCyan font-bold mt-0.5">${formatPrice(item.priceUSD)}</p>
                            <div class="flex items-center space-x-2 mt-2">
                                <button onclick="updateQty('${item.id}', -1)" class="w-5 h-5 bg-darkBg text-gray-300 rounded border border-gray-700 flex items-center justify-center text-xs hover:border-neonCyan">-</button>
                                <span class="text-xs font-semibold text-white">${item.qty}</span>
                                <button onclick="updateQty('${item.id}', 1)" class="w-5 h-5 bg-darkBg text-gray-300 rounded border border-gray-700 flex items-center justify-center text-xs hover:border-neonCyan">+</button>
                            </div>
                        </div>
                        <button onclick="removeFromCart('${item.id}')" class="text-gray-500 hover:text-neonCrimson p-1 text-sm">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                `;
            });

            cartItemsContainer.innerHTML = html;
            cartTotal.textContent = formatPrice(totalUSD);
        }

        // -------------------------------------------------------------
        // 4. RENDER PRODUCTS TO DOM
        // -------------------------------------------------------------
        function createProductCard(product) {
            const isFancy = product.category === 'fancy';
            const cardClass = isFancy ? 'fancy-card' : '';
            const btnColor = isFancy 
                ? 'bg-neonCrimson/20 border-neonCrimson/50 text-neonCrimson hover:bg-neonCrimson hover:text-white' 
                : 'bg-neonCyan/20 border-neonCyan/50 text-neonCyan hover:bg-neonCyan hover:text-darkBg';

            let starsHtml = '';
            for (let i = 1; i <= 5; i++) {
                starsHtml += `<i class="fa-solid fa-star ${i <= product.rating ? 'active' : ''}"></i>`;
            }

            return `
                <div class="product-card ${cardClass} glass-card rounded-2xl border border-gray-800 overflow-hidden flex flex-col justify-between group">
                    <div class="relative overflow-hidden bg-darkBg/50 p-4 flex items-center justify-center h-48">
                        <span class="absolute top-2 left-2 text-[9px] font-bold tracking-widest px-2 py-0.5 rounded-full border border-gray-700 bg-darkBg/80 text-white">
                            ${product.badge}
                        </span>
                        
                        <img src="${product.image}" alt="${product.name}" class="max-h-36 object-contain transform group-hover:scale-110 transition-transform duration-500">
                        
                        <button onclick="openQuickView('${product.id}')" class="absolute bottom-2 right-2 p-2 rounded-lg bg-darkBg/80 text-gray-300 hover:text-white hover:bg-neonCyan hover:text-darkBg transition-all opacity-0 group-hover:opacity-100 shadow-lg text-xs">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <div class="p-4 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="star-rating text-[10px] mb-1 space-x-0.5">
                                ${starsHtml}
                            </div>
                            <h4 class="text-sm font-bold text-white group-hover:text-neonCyan transition-colors line-clamp-1">${product.name}</h4>
                            <p class="text-[11px] text-gray-400 mt-1 line-clamp-2">${product.desc}</p>
                        </div>

                        <div class="mt-3 pt-3 border-t border-gray-800/80 flex items-center justify-between">
                            <div>
                                <span class="text-[10px] text-gray-500 block">Price</span>
                                <span class="text-sm font-black text-white">${formatPrice(product.priceUSD)}</span>
                            </div>

                            <button onclick="addToCart('${product.id}')" class="px-3 py-1.5 rounded-lg text-xs font-bold border ${btnColor} transition-all duration-300 flex items-center space-x-1">
                                <i class="fa-solid fa-cart-plus"></i>
                                <span>Add</span>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderProducts(filterCategory = 'all', searchQuery = '') {
            const womenGrid = document.getElementById('womenGrid');
            const menGrid = document.getElementById('menGrid');
            const boysGrid = document.getElementById('boysGrid');

            let filtered = products;

            // Search Filter
            if (searchQuery.trim() !== '') {
                const q = searchQuery.toLowerCase();
                filtered = filtered.filter(p => p.name.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q));
            }

            // Category Filter
            if (filterCategory === 'women') filtered = filtered.filter(p => p.gender === 'women');
            if (filterCategory === 'men') filtered = filtered.filter(p => p.gender === 'men');
            if (filterCategory === 'boys') filtered = filtered.filter(p => p.gender === 'boys');
            if (filterCategory === 'fancy') filtered = filtered.filter(p => p.category === 'fancy');
            if (filterCategory === 'sports') filtered = filtered.filter(p => p.category === 'sports');

            const womenItems = filtered.filter(p => p.gender === 'women');
            const menItems = filtered.filter(p => p.gender === 'men');
            const boysItems = filtered.filter(p => p.gender === 'boys');

            womenGrid.innerHTML = womenItems.length > 0 
                ? womenItems.map(p => createProductCard(p)).join('')
                : '<p class="text-gray-500 text-sm col-span-full py-4">No matching women shoes found.</p>';

            menGrid.innerHTML = menItems.length > 0 
                ? menItems.map(p => createProductCard(p)).join('')
                : '<p class="text-gray-500 text-sm col-span-full py-4">No matching men shoes found.</p>';

            boysGrid.innerHTML = boysItems.length > 0 
                ? boysItems.map(p => createProductCard(p)).join('')
                : '<p class="text-gray-500 text-sm col-span-full py-4">No matching boys shoes found.</p>';
        }

        // -------------------------------------------------------------
        // 5. QUICK VIEW MODAL
        // -------------------------------------------------------------
        const quickViewModal = document.getElementById('quickViewModal');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const modalContent = document.getElementById('modalContent');

        function openQuickView(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            modalContent.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                    <div class="bg-darkBg/80 p-4 rounded-xl border border-gray-800 flex items-center justify-center">
                        <img src="${product.image}" alt="${product.name}" class="max-h-56 object-contain">
                    </div>
                    <div class="space-y-4">
                        <span class="text-xs font-bold text-neonCyan tracking-widest uppercase">${product.gender.toUpperCase()} // ${product.category.toUpperCase()} SHOE</span>
                        <h3 class="text-2xl font-extrabold text-white">${product.name}</h3>
                        <p class="text-gray-300 text-sm leading-relaxed">${product.desc}</p>
                        
                        <div class="space-y-1">
                            <label class="text-xs text-gray-400 font-semibold block">Select Size (EU / US):</label>
                            <select class="bg-darkBg border border-gray-700 text-sm rounded-lg p-2 text-gray-200 focus:border-neonCyan outline-none w-full">
                                <option>EU 38 / US 6</option>
                                <option>EU 39 / US 7</option>
                                <option selected>EU 40 / US 8</option>
                                <option>EU 41 / US 9</option>
                                <option>EU 42 / US 10</option>
                            </select>
                        </div>

                        <div class="text-3xl font-black text-neonCyan">${formatPrice(product.priceUSD)}</div>
                        <div class="pt-2 flex gap-3">
                            <button onclick="addToCart('${product.id}'); closeModal();" class="flex-1 py-3 bg-neonCyan text-darkBg font-bold text-sm rounded-xl shadow-glow-cyan hover:bg-white transition-all">
                                Add to Cart (${formatPrice(product.priceUSD)})
                            </button>
                        </div>
                    </div>
                </div>
            `;

            quickViewModal.classList.remove('hidden');
        }

        function closeModal() {
            quickViewModal.classList.add('hidden');
        }

        closeModalBtn.addEventListener('click', closeModal);

        // -------------------------------------------------------------
        // 6. SEARCH & FILTER HANDLERS
        // -------------------------------------------------------------
        let currentFilter = 'all';

        const filterBtns = document.querySelectorAll('.filter-btn');
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('bg-neonCyan', 'text-darkBg', 'shadow-glow-cyan');
                    b.classList.add('bg-darkCard', 'text-gray-300');
                });

                btn.classList.remove('bg-darkCard', 'text-gray-300');
                btn.classList.add('bg-neonCyan', 'text-darkBg', 'shadow-glow-cyan');

                currentFilter = btn.dataset.filter;
                renderProducts(currentFilter, document.getElementById('searchInput').value);
            });
        });

        function handleSearch() {
            const query = document.getElementById('searchInput').value;
            renderProducts(currentFilter, query);
        }

        function handleSearchMobile() {
            const query = document.getElementById('searchInputMobile').value;
            renderProducts(currentFilter, query);
        }

        // -------------------------------------------------------------
        // 7. COUNTDOWN TIMER
        // -------------------------------------------------------------
        let hours = 12, minutes = 45, seconds = 0;
        setInterval(() => {
            seconds--;
            if (seconds < 0) { seconds = 59; minutes--; }
            if (minutes < 0) { minutes = 59; hours--; }
            if (hours < 0) { hours = 24; }

            document.getElementById('hours').textContent = hours.toString().padStart(2, '0');
            document.getElementById('minutes').textContent = minutes.toString().padStart(2, '0');
            document.getElementById('seconds').textContent = seconds.toString().padStart(2, '0');
        }, 1000);

        // -------------------------------------------------------------
        // 8. CANVAS PARTICLE BACKGROUND EFFECT
        // -------------------------------------------------------------
        const canvas = document.getElementById('particleCanvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2 + 0.5;
                this.speedX = (Math.random() - 0.5) * 0.5;
                this.speedY = (Math.random() - 0.5) * 0.5;
                this.color = Math.random() > 0.5 ? 'rgba(0, 243, 255, ' : 'rgba(255, 0, 85, ';
                this.alpha = Math.random() * 0.5 + 0.1;
            }

            update() {
                this.x += this.speedX;
                this.y += this.speedY;

                if (this.x < 0) this.x = canvas.width;
                if (this.x > canvas.width) this.x = 0;
                if (this.y < 0) this.y = canvas.height;
                if (this.y > canvas.height) this.y = 0;
            }

            draw() {
                ctx.fillStyle = this.color + this.alpha + ')';
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function initParticles() {
            particles = [];
            for (let i = 0; i < 60; i++) {
                particles.push(new Particle());
            }
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }

        initParticles();
        animateParticles();

        // Mobile menu toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Newsletter handler
        document.getElementById('newsletterForm').addEventListener('submit', (e) => {
            e.preventDefault();
            document.getElementById('newsletterMsg').classList.remove('hidden');
            e.target.reset();
        });

        // Initialize Products On Load
        window.onload = function() {
            renderProducts();
        };
    </script>
</body>
</html>